<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up notes, but not the encrypted key and Instagram
     sign-in (they can't be read on another device, and a sign-in shouldn't
     travel), the web view's cookies, or video files (large). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="media/" />
        <exclude domain="root" path="app_webview/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
        <exclude domain="file" path="media/" />
        <exclude domain="root" path="app_webview/" />
    </device-transfer>
</data-extraction-rules>
